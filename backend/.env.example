# Point this to a securely stored service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
# Or provide the complete service-account JSON as a Vercel secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Keep this key server-side; never place it in frontend HTML or JavaScript.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set to production when serving over HTTPS so auth cookies are Secure.
NODE_ENV=development
